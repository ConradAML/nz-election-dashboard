{
  "name": "myapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "VITE_DATA_SOURCE=live vite",
    "dev:simulated": "VITE_DATA_SOURCE=simulated vite",
    "build": "vite build",
    "website:deploy": "node deploy-website.js",
    "build:simulated": "VITE_DATA_SOURCE=simulated vite build",
    "data:update": "node election-data/update-election-data.js",
    "data:convert": "node election-data/update-election-data.js --skip-fetch",
    "worker:dev": "wrangler dev --config election-data/wrangler.jsonc --test-scheduled",
    "worker:deploy": "wrangler deploy --config election-data/wrangler.jsonc",
    "worker:tail": "wrangler tail --config election-data/wrangler.jsonc",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "plotly.js": "^3.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-plotly.js": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wrangler": "^4.131.2"
  }
}
